---
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, eager = false, class: className } = Astro.props;
---

<figure class:list={["frame", className]}>
  <img
    src={src}
    alt={alt}
    width="1920"
    height="1280"
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    fetchpriority={eager ? "high" : "auto"}
  />
</figure>
