---
import Logo from "./Logo.astro";
import { footerLinks, githubUrl, nav, releasesUrl, site } from "../content/copy";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <Logo height={24} />
        </a>
        <p>{site.tagline}</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={githubUrl}>GitHub</a>
        <a href={releasesUrl}>Releases</a>
        {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
    <p class="riot-notice">{site.riotNotice}</p>
  </div>
</footer>
