---
import lockup from "../../../../brand/logo-horizontal.svg?raw";

interface Props {
  height?: number;
}

const { height = 24 } = Astro.props;
const [, , viewWidth, viewHeight] = lockup.match(/viewBox="([^"]+)"/)![1].split(" ").map(Number);
const width = Math.round((height * viewWidth) / viewHeight);
const themed = lockup
  .replace(/<title>.*?<\/title>\s*/, "")
  .replaceAll('fill="#111111"', 'fill="var(--text)"')
  .replaceAll('stroke="#FFFFFF"', 'stroke="var(--page)"')
  .replace("<svg ", `<svg width="${width}" height="${height}" aria-hidden="true" focusable="false" `);
---

<span class="logo" set:html={themed} />
