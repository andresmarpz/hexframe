---
import Base from "../layouts/Base.astro";
import { notFound, site } from "../content/copy";
---

<Base title={`${notFound.headline} — ${site.name}`} description={notFound.body} noindex>
  <section class="page-head not-found">
    <div class="container narrow">
      <p class="code" aria-hidden="true">404</p>
      <h1>{notFound.headline}</h1>
      <p class="lead">{notFound.body}</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">{notFound.home}</a>
        <a class="btn btn-secondary" href="/download/">{notFound.download}</a>
      </div>
    </div>
  </section>
</Base>
