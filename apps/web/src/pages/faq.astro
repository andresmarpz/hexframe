---
import Base from "../layouts/Base.astro";
import { withCode } from "../lib/inline-code";
import { faqGroups, faqPage, helpSection } from "../content/faq";
---

<Base title={`${faqPage.title} — Greyscreen`} description={faqPage.description}>
  <section class="page-head">
    <div class="container narrow">
      <h1>{faqPage.title}</h1>
      <p class="lead">{faqPage.intro}</p>
      <nav class="toc" aria-label="Questions">
        {
          faqGroups.map((group) => (
            <div>
              <h2 class="toc-title">{group.title}</h2>
              <ul>
                {group.items.map((item) => <li><a href={`#${item.id}`}>{item.q}</a></li>)}
              </ul>
            </div>
          ))
        }
        <div>
          <h2 class="toc-title">{helpSection.title}</h2>
          <ul>
            <li><a href={`#${helpSection.id}`}>{helpSection.title}</a></li>
          </ul>
        </div>
      </nav>
    </div>
  </section>

  <section class="section tight">
    <div class="container narrow qa">
      {
        faqGroups.map((group) => (
          <section aria-labelledby={`${group.id}-title`}>
            <h2 id={`${group.id}-title`}>{group.title}</h2>
            {group.intro && <p class="group-intro">{group.intro}</p>}
            {group.items.map((item) => (
              <article class="qa-item" id={item.id}>
                <h3><a class="anchor" href={`#${item.id}`}>{item.q}</a></h3>
                {item.a.map((paragraph) => <p set:html={withCode(paragraph)} />)}
              </article>
            ))}
          </section>
        ))
      }

      <section aria-labelledby="help-title">
        <h2 id="help-title">{helpSection.title}</h2>
        <p class="group-intro">{helpSection.intro}</p>
        <article class="qa-item" id={helpSection.id}>
          <ul class="help">
            {
              helpSection.items.map((item) => (
                <li class="card">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  {item.href && <p><a href={item.href} rel="noopener">{item.linkLabel}</a></p>}
                </li>
              ))
            }
          </ul>
          <p class="fine">{helpSection.logsNote}</p>
        </article>
      </section>
    </div>
  </section>
</Base>
