---
import Base from "../layouts/Base.astro";
import { privacy } from "../content/privacy";
---

<Base title={`${privacy.title} — Greyscreen`} description={privacy.description}>
  <section class="page-head">
    <div class="container narrow">
      <h1>{privacy.title}</h1>
      <p class="lead">{privacy.intro}</p>
      <p class="fine">{privacy.updated}</p>
    </div>
  </section>

  <section class="section tight">
    <div class="container narrow prose">
      <h2 id="local">{privacy.localTitle}</h2>
      <ul class="list">
        {privacy.local.map((item) => <li>{item}</li>)}
      </ul>

      <h2 id="sent">{privacy.sentTitle}</h2>
      <div class="stack">
        {
          privacy.sent.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>

      <h2 id="website">{privacy.websiteTitle}</h2>
      <ul class="list">
        {privacy.website.map((item) => <li>{item}</li>)}
      </ul>

      <h2 id="contact">{privacy.contactTitle}</h2>
      <p>{privacy.contact}</p>
      <p>
        {privacy.contactLinks.map((link, i) => <>{i > 0 && " · "}<a href={link.href} rel="noopener">{link.label}</a></>)}
      </p>
      <p class="fine">{privacy.changes}</p>
    </div>
  </section>
</Base>
