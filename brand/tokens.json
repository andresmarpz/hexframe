  "typography": {
    "family": {
      "sans": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", \"Cascadia Mono\", Consolas, monospace"
    },
    "scale": {
      "display": { "size": "40px", "lineHeight": "44px", "weight": 400, "letterSpacing": "-0.025em", "tabular": true },
      "title": { "size": "22px", "lineHeight": "28px", "weight": 500, "letterSpacing": "-0.015em" },
      "heading": { "size": "16px", "lineHeight": "22px", "weight": 500, "letterSpacing": "-0.01em" },
      "body": { "size": "14px", "lineHeight": "21px", "weight": 400, "letterSpacing": "0em" },
      "bodyMedium": { "size": "14px", "lineHeight": "21px", "weight": 500, "letterSpacing": "0em" },
      "ui": { "size": "13px", "lineHeight": "20px", "weight": 400, "letterSpacing": "0em" },
      "uiMedium": { "size": "13px", "lineHeight": "20px", "weight": 500, "letterSpacing": "0em" },
      "caption": { "size": "12px", "lineHeight": "18px", "weight": 400, "letterSpacing": "0em" },
      "micro": { "size": "11px", "lineHeight": "15px", "weight": 500, "letterSpacing": "0.01em" }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "layout": {
      "appMaxWidth": "880px",
      "webMaxWidth": "1120px",
      "navHeight": "52px",
      "pageGutter": "24px"
    }
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "10px",
    "2xl": "12px",
    "pill": "9999px"
  },
  "shadow": {
    "dark": {
      "raised": "0 1px 2px rgba(0, 0, 0, 0.42), 0 0 0 1px #2C2E33",
      "floating": "0 6px 18px rgba(0, 0, 0, 0.48), 0 0 0 1px #2C2E33",
      "overlay": "0 14px 36px rgba(0, 0, 0, 0.58), 0 0 0 1px #3C3F47",
      "button": "0 1px 1.5px rgba(0, 0, 0, 0.36)"
    },
    "light": {
      "raised": "0 1px 2px rgba(20, 24, 34, 0.06), 0 0 0 1px #DCDFE6",
      "floating": "0 6px 18px rgba(20, 24, 34, 0.10), 0 0 0 1px #DCDFE6",
      "overlay": "0 14px 36px rgba(20, 24, 34, 0.14), 0 0 0 1px #DCDFE6",
      "button": "0 1px 1.5px rgba(20, 24, 34, 0.07)"
    }
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "120ms",
      "base": "160ms",
      "slow": "220ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "snappy": "cubic-bezier(0.2, 0, 0, 1)"
    }
  }
