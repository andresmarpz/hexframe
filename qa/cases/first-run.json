{
  "about": "The first-run card walks through folder, quality and the test recording, then Done hides it for good. Headless runs have no engine, so the test only shows its running state.",
  "scene": "home-first-run",
  "size": [
    1100,
    700
  ],
  "steps": [
    {
      "check": "card",
      "has": [
        "first-run",
        "first-run-folder",
        "first-run-quality",
        "first-run-test",
        "first-run-done"
      ]
    },
    {
      "tap": "first-run-quality >> segment0"
    },
    {
      "tap": "first-run-test"
    },
    {
      "check": "testing",
      "has": [
        "first-run-testing",
        "first-run-test",
        "first-run-test-spinner"
      ]
    },
    {
      "tap": "first-run-done"
    },
    {
      "check": "done",
      "lacks": [
        "first-run"
      ],
      "has": [
        "state-card"
      ]
    }
  ]
}
