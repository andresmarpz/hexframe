{
  "about": "D starts the death review on a game with deaths: tag a death, step through them, finish on the summary.",
  "scene": "death-review-start",
  "steps": [
    {"check": "before", "has": ["review-deaths"], "lacks": ["death-review"], "snap": false},
    {"press": "d"},
    {"check": "first-death", "has": ["death-review", "death-tags", "death-next"]},
    {"tap": "death-tag-ganked"},
    {"tap": "death-next"},
    {"check": "second-death", "has": ["death-review", "death-prev"]},
    {"tap": "death-finish"},
    {"check": "summary", "has": ["death-summary"]}
  ]
}
