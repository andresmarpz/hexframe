{
  "about": "Picking Dock in settings swaps the sidebar for the floating dock at once, and Sidebar swaps it back.",
  "scene": "games-pick",
  "steps": [
    {"tap": "nav-settings"},
    {"tap": "nav-style >> segment1"},
    {"check": "dock", "has": ["dock", "settings-sheet"], "lacks": ["nav"]},
    {"tap": "nav-style >> segment0"},
    {"check": "sidebar", "has": ["nav"], "lacks": ["dock"], "snap": false},
    {"press": "Escape"},
    {"tap": "nav-settings"},
    {"check": "reopened", "has": ["settings-sheet", "nav"], "snap": false}
  ]
}
