{
  "about": "The review's event filter menu opens over the panel, a pick changes the events shown, and Escape closes it.",
  "scene": "review",
  "steps": [
    {
      "tap": "event-filter"
    },
    {
      "check": "menu",
      "has": [
        "filter-menu-menu",
        "filter-menu-item0"
      ]
    },
    {
      "tap": "filter-menu-item1"
    },
    {
      "check": "picked",
      "has": [
        "filter-menu-menu"
      ],
      "snap": true
    },
    {
      "press": "Escape"
    },
    {
      "check": "closed",
      "lacks": [
        "filter-menu-menu"
      ],
      "has": [
        "events-scroll"
      ],
      "snap": false
    }
  ]
}
