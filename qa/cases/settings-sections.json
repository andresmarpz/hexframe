{
  "about": "Settings opens as a sheet over the games screen and every section shows its rows.",
  "scene": "games-pick",
  "steps": [
    {"tap": "nav-settings"},
    {"check": "general", "has": ["settings-sheet", "settings-general", "nav-style-row", "update-row"]},
    {"tap": "settings-nav-recording"},
    {"check": "recording", "has": ["settings-recording", "quality-row"]},
    {"tap": "settings-nav-clips"},
    {"check": "clips", "has": ["settings-clips", "review-events-row"]},
    {"tap": "settings-nav-storage"},
    {"check": "storage", "has": ["settings-storage"]},
    {"tap": "settings-nav-keybinds"},
    {"check": "keybinds", "has": ["settings-keybinds"]},
    {"press": "Escape"},
    {"check": "closed", "lacks": ["settings-sheet"], "has": ["games-pick"], "snap": false}
  ]
}
